{
  "manifest_version": 3,
  "name": "视频AI总结 · B站/抖音",
  "version": "1.2.2",
  "description": "在 B站 / 抖音 视频页一键提取字幕、弹幕与文案，用 DeepSeek 生成结构化 AI 总结。B站字幕按「签名接口 → 官方AI文稿 → 无签名接口」三渠道自动降级。 支持视频连续追问与联网搜索，附可点击来源。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.douyin.com/*",
    "*://*.douyinvod.com/*",
    "*://*.byteimg.com/*",
    "*://*.zjcdn.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "视频AI总结",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/bangumi/play/*",
        "*://m.bilibili.com/video/*"
      ],
      "js": [
        "content/common.js",
        "content/wbi.js",
        "content/bilibili.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/douyin-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/common.js",
        "content/douyin.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_bili_subtitle",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
