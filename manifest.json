{
  "manifest_version": 3,
  "name": "知页 · 视频与网页 AI 阅读",
  "version": "2.0.0",
  "description": "视频看字幕、网页读正文，统一出一个总结；可追问、按需联网、每篇页面各自留档。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.douyin.com/*",
    "*://*.douyinvod.com/*",
    "*://*.byteimg.com/*",
    "*://*.zjcdn.com/*",
    "https://api.deepseek.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*"
  ],
  "optional_host_permissions": [
    "https://dav.jianguoyun.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "知页",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/router.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/bangumi/play/*",
        "*://m.bilibili.com/video/*"
      ],
      "js": [
        "content/common.js",
        "content/wbi.js",
        "content/bilibili.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/douyin-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/common.js",
        "content/douyin.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_bili_subtitle",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
